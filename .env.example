# Shopify MCP Server configuration
#
# Leave this file empty (or unset all three variables) to run in DEMO MODE:
# the server serves the bundled "Aurora Athletics" fixture store and every
# tool works without any credentials.
#
# To connect a real store, fill in all of the values below. See README.md
# ("Connecting a real Shopify store") for how to create a custom app and
# generate an Admin API access token.

# Your store's myshopify.com domain, e.g. aurora-athletics.myshopify.com
# (the storefront's custom domain will NOT work here).
SHOPIFY_STORE_DOMAIN=

# Admin API access token for a custom app (starts with "shpat_").
# Required scopes: read_products, read_orders, read_customers,
# read_inventory, write_inventory (write_inventory only if you want the
# update_inventory tool to work).
SHOPIFY_ACCESS_TOKEN=

# Shopify Admin API version. Optional - defaults to 2026-04.
SHOPIFY_API_VERSION=2026-04
